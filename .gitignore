# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment. uv.lock is tracked on purpose so runs are reproducible.
.venv/

# Experiment output. Everything here is regenerable from a config plus a seed,
# so checkpoints, sampled points and figures stay out. The metrics log, the
# resolved config and the corrector traces are kept: they are the record of what
# a run actually did, and report/ cites them. Figures for the write-up live in
# report/figures/, which IS tracked.
runs/**/ckpt/
runs/**/samples/
runs/**/figures/
runs/**/*.pt
runs/**/*.png
runs/**/*.csv
runs/*.log
runs/**/*.log

# Editors and OS
.DS_Store
.vscode/
.idea/
.ipynb_checkpoints/

# Local tool settings
.claude/settings.local.json

# Built from report/*.tex; regenerable.
report/*.pdf
